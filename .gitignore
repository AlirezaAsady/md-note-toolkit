# ---------------------------------------------------------------
# md-note-toolkit
# NOTE: *.md must NEVER be blanket-ignored here.
# README.md, README.fa.md, docs/*.md and examples/*.md are product
# documentation and must stay in version control.
# ---------------------------------------------------------------

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Packaging / build output
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Test and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# ---------------------------------------------------------------
# Tool runtime artifacts, produced by the scripts, never hand-written:
#   *.rtl.md  <- md_rtl_advance_gui.OUT_SUFFIX
#   *.out.md  <- md_color_gui.OUT_SUFFIX
#   *.raw.md  <- md_batch.py reverse output
#   *.bak     <- replace-original fallback, and md_menu_tools.py set-css
#   *.tmp     <- md_menu_tools.py set-css, renamed over the target
# Suffix patterns only, so docs and examples stay tracked.
# ---------------------------------------------------------------
*.rtl.md
*.out.md
*.raw.md
*.bak
*.tmp

# Local scratch space for experiments and bug reproduction
/scratch/

# ---------------------------------------------------------------
# OS and editor noise
# ---------------------------------------------------------------
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
.DS_Store
._*
*.swp
*.swo
*~

.idea/
.vscode/
*.sublime-workspace
*.sublime-project

# Secrets, should never exist here but guard anyway
.env
.env.*
*.pem
*.key

# ---------------------------------------------------------------
# Deliberately NOT ignored:
#   md.css    - shipped with the tool, part of the product
#   tests/    - the suite must be in the repo for CI
#   *.cmd     - md_menu.cmd is a shipped launcher
# ---------------------------------------------------------------
